[Unit]
Description=Bleem WeChat Admin API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/wechat-admin
EnvironmentFile=/etc/wechat-admin/wechat-admin.env
ExecStartPre=+/usr/bin/install -d -o www-data -g www-data -m 0755 /opt/wechat-admin/logs
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/wechat-admin/wechat-admin.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
